        <div class="tab active" data-tab="hub" onclick="switchPage('hub')">Hub</div>
        <div class="tab" data-tab="pp" onclick="switchPage('pp');setSub('pp','doer')">Product &amp; Portfolio</div>
        <div class="tab" data-tab="dd" onclick="switchPage('dd');setSub('dd','doer')">DevOps &amp; Delivery</div>
        <div class="tab" data-tab="rv" onclick="switchPage('rv');setSub('rv','doer')">Run &amp; Vendor Ops</div>
        <div class="tab" data-tab="gr" onclick="switchPage('gr');setSub('gr','doer')">Governance &amp; Reporting</div>
