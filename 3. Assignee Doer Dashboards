              <tbody>
                <tr><td>REQ-122</td><td>Define global SLA breach criteria</td><td><span class="badge warn">Needs Info</span></td><td>Feb 6</td></tr>
                <tr><td>FTR-310</td><td>OUS dashboard filters</td><td><span class="badge info">Under Review</span></td><td>Feb 8</td></tr>
              </tbody>
