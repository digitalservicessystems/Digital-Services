  <script>
    function switchPage(key){
      document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
      document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active"));
      document.getElementById("page-" + key).classList.add("active");
      document.querySelector('.tab[data-tab="'+key+'"]').classList.add("active");
      window.scrollTo({top:0, behavior:"smooth"});
    }

    function setSub(app, sub){
      // hide all subpages for this app
      document.querySelectorAll("#page-"+app+" .subpage").forEach(el=>el.style.display="none");
      // remove subtab active
      document.querySelectorAll("#page-"+app+" .subtab").forEach(el=>el.classList.remove("active"));

      const panel = document.getElementById(app+"-"+sub);
      if(panel) panel.style.display="block";

      const st = document.querySelector('#page-'+app+' .subtab[data-sub="'+app+'-'+sub+'"]');
      if(st) st.classList.add("active");
    }
  </script>
