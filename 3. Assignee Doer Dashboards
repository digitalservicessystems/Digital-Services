          </div>
          <div class="card">
            <h2>Quick Actions</h2>
            <p>Replace these with your Smartsheet form/dashboard links.</p>
            <div style="display:flex; gap:10px; flex-wrap:wrap">
              <a class="btn primary" href="#" onclick="alert('Link: Requirements Update Form');return false;">Update Requirements</a>
