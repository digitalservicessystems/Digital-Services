        </div>

        <div class="grid c2" style="margin-top:14px">
          <div class="card">
            <h2>My Assigned Work (Open)</h2>
            <table class="table">
              <thead><tr><th>ID</th><th>Work</th><th>Type</th><th>Status</th><th>Due</th></tr></thead>
              <tbody>
                <tr><td>REQ-122</td><td>Define global SLA breach criteria</td><td>Requirement</td><td><span class="badge warn">Needs Info</span></td><td>Feb 6</td></tr>
                <tr><td>FTR-310</td><td>OUS dashboard filters</td><td>Feature</td><td><span class="badge info">Under Review</span></td><td>Feb 8</td></tr>
