                <tr><td>EP-090</td><td>Finalize scope notes</td><td>Approval</td><td>You</td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="subpage" id="pp-overview" style="display:none">
        <div class="card"><h2>Overview</h2><p>Portfolio rollups, allocation, roadmap confidence, and at-risk epics.</p></div>
      </div>
      <div class="subpage" id="pp-roadmap" style="display:none">
        <div class="card"><h2>Roadmaps</h2><p>Now / Next / Later views.</p></div>
      </div>
      <div class="subpage" id="pp-backlog" style="display:none">
        <div class="card"><h2>Backlog</h2><p>Epics, Features, Stories and Requirements.</p></div>
      </div>
    </section>

    <!-- DEVOPS & DELIVERY -->
    <section class="page" id="page-dd">
      <div class="subtabs">
        <div class="subtab active" data-sub="dd-doer" onclick="setSub('dd','doer')">Doer Dashboard</div>
