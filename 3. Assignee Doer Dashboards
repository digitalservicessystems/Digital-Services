<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>EDSPPM • Digital Services Hub (Interactive)</title>
  <style>
    :root{
      --bg:#f6f8fc; --panel:#ffffff; --text:#0b1220; --muted:#55637a;
      --border:rgba(15,23,42,.12); --shadow:0 14px 34px rgba(15,23,42,.12);
      --brand1:#6d28d9; --brand2:#0891b2;
      --ok:#16a34a; --warn:#d97706; --bad:#dc2626;
      --r:18px; --pad:18px;
      --sans: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
      --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono","Courier New", monospace;
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0; font-family:var(--sans); color:var(--text);
      background:
        radial-gradient(900px 480px at 15% 6%, rgba(109,40,217,.12), transparent 60%),
        radial-gradient(800px 420px at 88% 18%, rgba(8,145,178,.10), transparent 55%),
        radial-gradient(700px 420px at 50% 105%, rgba(22,163,74,.08), transparent 60%),
        var(--bg);
    }
    a{color:inherit; text-decoration:none}
    hr{border:0;border-top:1px solid var(--border);margin:14px 0}

    .topbar{
      position:sticky; top:0; z-index:50;
      display:flex; align-items:center; gap:12px;
      padding:14px 16px;
      backdrop-filter: blur(10px);
      background: rgba(255,255,255,.75);
      border-bottom:1px solid var(--border);
    }
    .brand{display:flex; align-items:center; gap:10px; font-weight:900; letter-spacing:.2px;}
    .logo{width:34px;height:34px;border-radius:12px;background:linear-gradient(135deg,var(--brand1),var(--brand2));box-shadow:0 14px 32px rgba(109,40,217,.18);}
    .pill{display:inline-flex;align-items:center;gap:8px;padding:7px 10px;border:1px solid var(--border);background:rgba(255,255,255,.9);border-radius:999px;color:var(--muted);font-size:12px}
    .spacer{flex:1}
    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:8px;
      padding:9px 12px;border-radius:12px;border:1px solid var(--border);
      background:rgba(255,255,255,.95); color:var(--text); cursor:pointer;
      transition:transform .08s ease, background .15s ease, border-color .15s ease, box-shadow .15s ease;
      box-shadow:0 8px 20px rgba(15,23,42,.06);
    }
    .btn:hover{background:#fff;border-color:rgba(15,23,42,.18);box-shadow:0 10px 26px rgba(15,23,42,.10)}
    .btn:active{transform:translateY(1px)}
    .btn.primary{background:linear-gradient(135deg, rgba(109,40,217,.95), rgba(8,145,178,.92)); color:#fff; border-color:rgba(255,255,255,.35); box-shadow:0 14px 28px rgba(109,40,217,.18)}

    .wrap{max-width:1280px; margin:0 auto; padding:18px}
    .hero{padding:18px 0 6px 0}
    .hero h1{margin:0 0 8px 0; font-size:30px; letter-spacing:-.02em}
    .hero p{margin:0; color:var(--muted); line-height:1.6}

    .tabs{display:flex; gap:10px; flex-wrap:wrap; margin:12px 0 0 0}
    .tab{
      padding:8px 10px; border-radius:999px;
      border:1px solid var(--border);
      background:rgba(255,255,255,.92);
      color:var(--muted); font-size:13px; cursor:pointer;
      box-shadow:0 8px 18px rgba(15,23,42,.06);
      user-select:none;
    }
    .tab.active{background:rgba(109,40,217,.10); border-color:rgba(109,40,217,.25); color:var(--text)}

    .grid{display:grid; gap:14px}
    .grid.c2{grid-template-columns: 1.2fr .8fr}
    .grid.c3{grid-template-columns: 1fr 1fr 1fr}
    .grid.c4{grid-template-columns: 1fr 1fr 1fr 1fr}
    @media (max-width:1100px){ .grid.c2,.grid.c3,.grid.c4{grid-template-columns:1fr} }

    .card{border:1px solid var(--border); background:var(--panel); border-radius: var(--r); box-shadow: var(--shadow); padding: var(--pad);}
    .card.compact{padding:14px; border-radius:16px}
    .card h2{margin:0 0 6px 0; font-size:18px}
    .card p{margin:0 0 10px 0; color:var(--muted); line-height:1.5}

    .kpi .label{color:var(--muted); font-size:12px; letter-spacing:.08em; text-transform:uppercase}
    .kpi .big{font-size:28px; font-weight:900; letter-spacing:-.02em}

    .delta{margin-top:6px; display:inline-flex; gap:6px; font-size:12px; padding:6px 9px; border-radius:999px; border:1px solid var(--border); background:rgba(2,6,23,.02);}
    .delta.ok{color:#0f5132;border-color:rgba(22,163,74,.22);background:rgba(22,163,74,.08)}
    .delta.warn{color:#7c2d12;border-color:rgba(217,119,6,.22);background:rgba(217,119,6,.08)}
    .delta.bad{color:#7f1d1d;border-color:rgba(220,38,38,.22);background:rgba(220,38,38,.08)}

    .badge{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border-radius:999px;font-size:12px;border:1px solid var(--border);background:rgba(2,6,23,.02)}
    .badge.ok{border-color:rgba(22,163,74,.24);background:rgba(22,163,74,.10);color:#0f5132}
    .badge.warn{border-color:rgba(217,119,6,.24);background:rgba(217,119,6,.10);color:#7c2d12}
    .badge.bad{border-color:rgba(220,38,38,.24);background:rgba(220,38,38,.10);color:#7f1d1d}
    .badge.info{border-color:rgba(8,145,178,.24);background:rgba(8,145,178,.10);color:#0b4b5a}

    .table{width:100%; border-collapse:separate; border-spacing:0; overflow:hidden; border:1px solid var(--border); border-radius:16px; background:#fff;}
    .table th,.table td{padding:10px 12px; border-bottom:1px solid var(--border); font-size:13px; vertical-align:top}
    .table th{color:var(--muted); font-weight:800; text-align:left; background:rgba(2,6,23,.02)}
    .table tr:last-child td{border-bottom:0}

    .miniChart{height:240px; border-radius:16px; border:1px solid var(--border); background:rgba(2,6,23,.01); padding:14px; display:flex; flex-direction:column; gap:10px;}
    .barRow{display:flex; align-items:center; gap:10px}
    .barLbl{width:140px; color:var(--muted); font-size:12px}
    .bar{flex:1; height:10px; border-radius:999px; background:rgba(2,6,23,.08); overflow:hidden}
    .bar > i{display:block; height:100%; width:50%; background:linear-gradient(90deg, rgba(109,40,217,.95), rgba(8,145,178,.92))}
    .barVal{width:56px; text-align:right; font-family:var(--mono); font-size:12px; color:rgba(15,23,42,.88)}

    .cardsGrid{display:grid; gap:14px; grid-template-columns:repeat(2, minmax(0,1fr))}
    @media (max-width:900px){ .cardsGrid{grid-template-columns:1fr} }

    .callout{display:flex; gap:12px; padding:12px 14px; border-radius:16px; border:1px dashed rgba(15,23,42,.18); background:rgba(255,255,255,.85);}
    .ico{width:30px; height:30px; border-radius:12px; display:grid; place-items:center; border:1px solid var(--border); background:rgba(2,6,23,.02)}
    .code{font-family:var(--mono); font-size:12px; padding:2px 6px; border:1px solid var(--border); border-radius:10px; background:rgba(2,6,23,.02)}

    .page{display:none}
    .page.active{display:block}

    .subtabs{display:flex; gap:10px; flex-wrap:wrap; margin:0 0 12px 0}
    .subtab{padding:7px 10px; border-radius:999px; border:1px solid var(--border); background:#fff; color:var(--muted); font-size:12px; cursor:pointer; box-shadow:0 8px 18px rgba(15,23,42,.05)}
    .subtab.active{background:rgba(8,145,178,.10); border-color:rgba(8,145,178,.22); color:var(--text)}
    .footer{color:var(--muted); font-size:12px; margin-top:12px}
  </style>
</head>
<body>
  <div class="topbar">
    <div class="brand"><div class="logo"></div>Digital Services Hub</div>
    <div class="pill">Enterprise Digital Services Portfolio &amp; Program Management (EDSPPM)</div>
    <div class="spacer"></div>
    <a class="btn" href="#" onclick="switchPage('hub');return false;">Hub</a>
    <a class="btn primary" href="#" onclick="switchPage('pp');setSub('pp','doer');return false;">Go to My Work</a>
  </div>

  <div class="wrap">
