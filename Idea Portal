  <script>
    const roleSel = document.getElementById('roleSel');
    const roleBadge = document.getElementById('roleBadge');

    const roleLabels = {
      requestor: "Requestor",
      manager: "Manager",
      pm: "PM / Doer",
      steerco: "SteerCo",
      leadership: "Leadership"
    };

    function setRole(role){
      roleBadge.textContent = roleLabels[role] || "Role";
      roleBadge.className = "badge info";
      if(role === "pm") roleBadge.className = "badge purple";
      if(role === "manager") roleBadge.className = "badge info";
      if(role === "steerco" || role === "leadership") roleBadge.className = "badge info";

      // Show/hide nav groups by role
      document.querySelectorAll(".navGroup").forEach(g=>{
        const roles = (g.getAttribute("data-roles") || "").split(" ").filter(Boolean);
        g.style.display = roles.includes(role) ? "block" : "none";
      });

      // Default landing per role
      if(role === "pm") openPage("pm-doer");
      else if(role === "manager") openPage("manager-portal");
      else if(role === "steerco" || role === "leadership") openPage("portfolio-insights");
      else openPage("idea-portal");
    }

    roleSel.addEventListener("change", e => setRole(e.target.value));

    function openPage(id){
      // activate page
      document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
      const page = document.getElementById(id);
      if(page) page.classList.add("active");

      // activate nav item
      document.querySelectorAll(".navItem").forEach(i=>i.classList.remove("active"));
      const nav = document.querySelector('.navItem[data-page="'+id+'"]');
      if(nav) nav.classList.add("active");

      // scroll
      window.scrollTo({top:0, behavior:"smooth"});
    }

    function fakeLink(url, label){
      alert(label + ":\nReplace placeholder with a real Smartsheet link:\n" + url);
    }

    function showShell(){
      document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active"));
      document.querySelector('.tab[data-tab="workapp"]').classList.add("active");
      document.getElementById("shell").style.display = "block";
      document.getElementById("structure").style.display = "none";
      document.getElementById("stages").style.display = "none";
    }
    function showStructure(){
      document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active"));
      document.querySelector('.tab[data-tab="structure"]').classList.add("active");
      document.getElementById("shell").style.display = "none";
      document.getElementById("structure").style.display = "block";
      document.getElementById("stages").style.display = "none";
      window.scrollTo({top:0, behavior:"smooth"});
    }
    function showStages(){
      document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active"));
      document.querySelector('.tab[data-tab="stages"]').classList.add("active");
      document.getElementById("shell").style.display = "none";
      document.getElementById("structure").style.display = "none";
      document.getElementById("stages").style.display = "block";
      window.scrollTo({top:0, behavior:"smooth"});
    }

    // init
    setRole("requestor");
  </script>
