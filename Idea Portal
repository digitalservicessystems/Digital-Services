<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1"/>
  <title>EDSPPM • Idea & Feedback Management (Interactive WorkApp)</title>
  <style>
    :root{
      /* Light / enterprise theme */
      --bg:#f6f8fc;
      --panel:#ffffff;
      --text:#0b1220;
      --muted:#55637a;
      --border:rgba(15,23,42,.12);
      --shadow:0 14px 34px rgba(15,23,42,.12);

      /* Brand */
      --brand1:#6d28d9;
      --brand2:#0891b2;

      /* Status colors */
      --ok:#16a34a;
      --warn:#d97706;
      --bad:#dc2626;

      --r:18px;
      --pad:18px;

      --sans: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
      --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono","Courier New", monospace;
    }

    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0; font-family:var(--sans); color:var(--text);
      background:
        radial-gradient(900px 480px at 15% 6%, rgba(109,40,217,.12), transparent 60%),
        radial-gradient(800px 420px at 88% 18%, rgba(8,145,178,.10), transparent 55%),
        radial-gradient(700px 420px at 50% 105%, rgba(22,163,74,.08), transparent 60%),
        var(--bg);
    }
    a{color:inherit; text-decoration:none}
    button{font-family:inherit}
    hr{border:0;border-top:1px solid var(--border);margin:14px 0}

    /* Top bar */
    .topbar{
      position:sticky; top:0; z-index:50;
      display:flex; align-items:center; gap:12px;
      padding:14px 16px;
      backdrop-filter: blur(10px);
      background: rgba(255,255,255,.78);
      border-bottom:1px solid var(--border);
    }
    .brand{display:flex; align-items:center; gap:10px; font-weight:900; letter-spacing:.2px;}
    .logo{
      width:34px;height:34px;border-radius:12px;
      background:linear-gradient(135deg,var(--brand1),var(--brand2));
      box-shadow:0 14px 32px rgba(109,40,217,.18);
    }
    .pill{
      display:inline-flex;align-items:center;gap:8px;
      padding:7px 10px;border:1px solid var(--border);
      background:rgba(255,255,255,.92);
      border-radius:999px;color:var(--muted);font-size:12px
    }
    .spacer{flex:1}

    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:8px;
      padding:9px 12px;border-radius:12px;border:1px solid var(--border);
      background:rgba(255,255,255,.96);
      color:var(--text);
      cursor:pointer;
      transition:transform .08s ease, background .15s ease, border-color .15s ease, box-shadow .15s ease;
      box-shadow:0 8px 20px rgba(15,23,42,.06);
      user-select:none;
    }
    .btn:hover{background:#fff;border-color:rgba(15,23,42,.18);box-shadow:0 10px 26px rgba(15,23,42,.10)}
    .btn:active{transform:translateY(1px)}
    .btn.primary{
      background:linear-gradient(135deg, rgba(109,40,217,.95), rgba(8,145,178,.92));
      color:#fff;
      border-color:rgba(255,255,255,.35);
      box-shadow:0 14px 28px rgba(109,40,217,.18);
    }
    .btn.ghost{
      background:rgba(255,255,255,.72);
    }

    /* Layout */
    .wrap{max-width:1320px; margin:0 auto; padding:18px}
    .hero{padding:10px 0 6px 0}
    .hero h1{margin:0 0 6px 0; font-size:28px; letter-spacing:-.02em}
    .hero p{margin:0; color:var(--muted); line-height:1.6}

    .grid{display:grid; gap:14px}
    .grid.c2{grid-template-columns: 1.2fr .8fr}
    .grid.c3{grid-template-columns: 1fr 1fr 1fr}
    .grid.c4{grid-template-columns: 1fr 1fr 1fr 1fr}
    @media (max-width:1100px){ .grid.c2,.grid.c3,.grid.c4{grid-template-columns:1fr} }

    .card{
      border:1px solid var(--border);
      background:var(--panel);
      border-radius: var(--r);
      box-shadow: var(--shadow);
      padding: var(--pad);
    }
    .card.compact{padding:14px; border-radius:16px}
    .card h2{margin:0 0 6px 0; font-size:18px}
    .card p{margin:0 0 10px 0; color:var(--muted); line-height:1.5}

    /* Tabs */
    .tabs{display:flex; gap:10px; flex-wrap:wrap; margin:12px 0 0 0}
    .tab{
      padding:8px 10px; border-radius:999px;
      border:1px solid var(--border);
      background:rgba(255,255,255,.92);
      color:var(--muted); font-size:13px; cursor:pointer;
      box-shadow:0 8px 18px rgba(15,23,42,.06);
      user-select:none;
    }
    .tab.active{
      background:rgba(109,40,217,.10);
      border-color:rgba(109,40,217,.25);
      color:var(--text)
    }

    /* KPI */
    .kpi .label{color:var(--muted); font-size:12px; letter-spacing:.08em; text-transform:uppercase}
    .kpi .big{font-size:28px; font-weight:900; letter-spacing:-.02em}
    .delta{
      margin-top:6px; display:inline-flex; gap:6px;
      font-size:12px; padding:6px 9px; border-radius:999px;
      border:1px solid var(--border);
      background:rgba(2,6,23,.02);
    }
    .delta.ok{color:#0f5132;border-color:rgba(22,163,74,.22);background:rgba(22,163,74,.08)}
    .delta.warn{color:#7c2d12;border-color:rgba(217,119,6,.22);background:rgba(217,119,6,.08)}
    .delta.bad{color:#7f1d1d;border-color:rgba(220,38,38,.22);background:rgba(220,38,38,.08)}

    /* Badges */
    .badge{
      display:inline-flex;align-items:center;gap:6px;
      padding:5px 9px;border-radius:999px;font-size:12px;
      border:1px solid var(--border);background:rgba(2,6,23,.02)
    }
    .badge.ok{border-color:rgba(22,163,74,.24);background:rgba(22,163,74,.10);color:#0f5132}
    .badge.warn{border-color:rgba(217,119,6,.24);background:rgba(217,119,6,.10);color:#7c2d12}
    .badge.bad{border-color:rgba(220,38,38,.24);background:rgba(220,38,38,.10);color:#7f1d1d}
    .badge.info{border-color:rgba(8,145,178,.24);background:rgba(8,145,178,.10);color:#0b4b5a}
    .badge.purple{border-color:rgba(109,40,217,.24);background:rgba(109,40,217,.10);color:#3b1a6b}

    /* Table */
    .table{
      width:100%; border-collapse:separate; border-spacing:0;
      overflow:hidden; border:1px solid var(--border); border-radius:16px;
      background:#fff;
    }
    .table th,.table td{
      padding:10px 12px;
      border-bottom:1px solid var(--border);
      font-size:13px; vertical-align:top
    }
    .table th{
      color:var(--muted); font-weight:800; text-align:left;
      background:rgba(2,6,23,.02)
    }
    .table tr:last-child td{border-bottom:0}
    .mono{font-family:var(--mono)}

    /* Mini charts */
    .miniChart{
      border-radius:16px; border:1px solid var(--border);
      background:rgba(2,6,23,.01);
      padding:14px; display:flex; flex-direction:column; gap:10px;
    }
    .barRow{display:flex; align-items:center; gap:10px}
    .barLbl{width:160px; color:var(--muted); font-size:12px}
    .bar{flex:1; height:10px; border-radius:999px; background:rgba(2,6,23,.08); overflow:hidden}
    .bar > i{display:block; height:100%; width:50%; background:linear-gradient(90deg, rgba(109,40,217,.95), rgba(8,145,178,.92))}
    .barVal{width:56px; text-align:right; font-family:var(--mono); font-size:12px; color:rgba(15,23,42,.88)}

    /* Callout */
    .callout{
      display:flex; gap:12px; padding:12px 14px; border-radius:16px;
      border:1px dashed rgba(15,23,42,.18);
      background:rgba(255,255,255,.85);
    }
    .ico{
      width:30px; height:30px; border-radius:12px;
      display:grid; place-items:center;
      border:1px solid var(--border);
      background:rgba(2,6,23,.02)
    }
    .code{
      font-family:var(--mono); font-size:12px;
      padding:2px 6px; border:1px solid var(--border);
      border-radius:10px; background:rgba(2,6,23,.02)
    }

    /* Left nav (WorkApp pages) */
    .layout{display:grid; grid-template-columns: 310px 1fr; gap:14px; margin-top:12px}
    @media (max-width:1100px){ .layout{grid-template-columns:1fr} }

    .nav{
      position:sticky; top:78px;
      align-self:start;
    }
    .nav .card{padding:14px}
    .navTitle{display:flex; align-items:center; justify-content:space-between; gap:10px}
    .navTitle b{font-size:13px}
    .navGroup{margin-top:10px}
    .navGroup .gtitle{
      font-size:12px; letter-spacing:.08em; text-transform:uppercase;
      color:var(--muted); margin:12px 0 6px 0
    }
    .navItem{
      display:flex; align-items:center; justify-content:space-between;
      padding:9px 10px; border-radius:12px;
      border:1px solid transparent;
      cursor:pointer;
      color:var(--text);
    }
    .navItem:hover{background:rgba(2,6,23,.02); border-color:rgba(15,23,42,.10)}
    .navItem.active{
      background:rgba(8,145,178,.10);
      border-color:rgba(8,145,178,.22);
    }
    .navItem small{color:var(--muted)}
    .dot{width:8px;height:8px;border-radius:999px;background:rgba(15,23,42,.24)}
    .dot.ok{background:rgba(22,163,74,.75)}
    .dot.warn{background:rgba(217,119,6,.80)}
    .dot.bad{background:rgba(220,38,38,.80)}
    .dot.info{background:rgba(8,145,178,.80)}
    .dot.purple{background:rgba(109,40,217,.80)}

    /* Page container */
    .page{display:none}
    .page.active{display:block}
    .footer{color:var(--muted); font-size:12px; margin-top:12px}

    /* Role switcher */
    select{
      border:1px solid var(--border);
      background:#fff;
      padding:9px 10px;
      border-radius:12px;
      box-shadow:0 8px 18px rgba(15,23,42,.05);
      color:var(--text);
      cursor:pointer;
    }
  </style>
</head>
<body>
  <div class="topbar">
    <div class="brand"><div class="logo"></div>Idea &amp; Feedback Management</div>
    <div class="pill">EDSPPM • Front Door to Product Development</div>
    <div class="spacer"></div>

    <span class="pill">
      Role:
      <select id="roleSel" aria-label="Role selector">
        <option value="requestor">Requestor / Submitter</option>
        <option value="manager">Functional Manager</option>
        <option value="pm">Product Manager / Idea Ops (Doer)</option>
        <option value="steerco">Steering Committee</option>
        <option value="leadership">Leadership</option>
      </select>
    </span>

    <button class="btn" onclick="openPage('idea-portal')">Idea Portal</button>
    <button class="btn primary" onclick="fakeLink('{{IDEA_SUBMISSION_FORM_URL}}','Submit Idea')">Submit Idea</button>
  </div>

  <div class="wrap">
    <div class="hero">
      <h1>One place to submit ideas, track progress, and capture feedback</h1>
      <p>This Work App is the enterprise front door (US + OUS) for ideation and feedback. Everything links back to the <b>Idea Table</b>.</p>
      <div class="tabs">
        <div class="tab active" data-tab="workapp" onclick="showShell()">Work App</div>
        <div class="tab" data-tab="structure" onclick="showStructure()">Structure &amp; Linking</div>
        <div class="tab" data-tab="stages" onclick="showStages()">Your Stages</div>
      </div>
    </div>

    <!-- WorkApp Shell -->
    <div id="shell">
      <div class="layout">
        <!-- NAV -->
        <aside class="nav">
          <div class="card">
            <div class="navTitle">
              <b>Pages (Idea &amp; Feedback)</b>
              <span class="badge info" id="roleBadge">Requestor</span>
            </div>

            <div class="navGroup" data-roles="requestor manager pm steerco leadership">
              <div class="gtitle">Front Door</div>
              <div class="navItem active" data-page="idea-portal" onclick="openPage('idea-portal')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot info"></span>Idea Portal</span>
                <small>Dashboard</small>
              </div>
              <div class="navItem" data-page="submit-idea" onclick="openPage('submit-idea')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot purple"></span>Submit an Idea</span>
                <small>Form</small>
              </div>
              <div class="navItem" data-page="delivered-feedback" onclick="openPage('delivered-feedback')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot ok"></span>Delivered + Feedback</span>
                <small>Dashboard</small>
              </div>
            </div>

            <div class="navGroup" data-roles="requestor">
              <div class="gtitle">My Views</div>
              <div class="navItem" data-page="my-ideas" onclick="openPage('my-ideas')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot"></span>My Ideas</span>
                <small>Report</small>
              </div>
              <div class="navItem" data-page="my-feedback" onclick="openPage('my-feedback')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot"></span>My Feedback</span>
                <small>Report</small>
              </div>
              <div class="navItem" data-page="waiting-on-me" onclick="openPage('waiting-on-me')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot warn"></span>Waiting on Me</span>
                <small>Report</small>
              </div>
            </div>

            <div class="navGroup" data-roles="manager">
              <div class="gtitle">Manager Views</div>
              <div class="navItem" data-page="manager-portal" onclick="openPage('manager-portal')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot info"></span>Manager Portal</span>
                <small>Dashboard</small>
              </div>
              <div class="navItem" data-page="team-ideas" onclick="openPage('team-ideas')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot"></span>My Team’s Ideas</span>
                <small>Report</small>
              </div>
              <div class="navItem" data-page="team-stale" onclick="openPage('team-stale')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot warn"></span>At Risk / Stale</span>
                <small>Report</small>
              </div>
            </div>

            <div class="navGroup" data-roles="pm">
              <div class="gtitle">Doer Views (PM / Idea Ops)</div>
              <div class="navItem" data-page="pm-doer" onclick="openPage('pm-doer')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot info"></span>Doer Dashboard</span>
                <small>Dashboard</small>
              </div>
              <div class="navItem" data-page="triage-queue" onclick="openPage('triage-queue')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot purple"></span>Triage Queue</span>
                <small>Report</small>
              </div>
              <div class="navItem" data-page="needs-info-queue" onclick="openPage('needs-info-queue')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot warn"></span>Needs More Info</span>
                <small>Report</small>
              </div>
              <div class="navItem" data-page="requirements-queue" onclick="openPage('requirements-queue')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot info"></span>Gathering Requirements</span>
                <small>Report</small>
              </div>
              <div class="navItem" data-page="approved-delivery" onclick="openPage('approved-delivery')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot ok"></span>Approved → Delivery</span>
                <small>Report</small>
              </div>
              <div class="navItem" data-page="feedback-monitor" onclick="openPage('feedback-monitor')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot"></span>Feedback Monitoring</span>
                <small>Dashboard</small>
              </div>
            </div>

            <div class="navGroup" data-roles="steerco leadership">
              <div class="gtitle">Executive / SteerCo</div>
              <div class="navItem" data-page="portfolio-insights" onclick="openPage('portfolio-insights')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot info"></span>Portfolio Insights</span>
                <small>Dashboard</small>
              </div>
              <div class="navItem" data-page="decision-ready" onclick="openPage('decision-ready')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot warn"></span>Decision-Ready Ideas</span>
                <small>Report</small>
              </div>
            </div>

            <div class="navGroup" data-roles="requestor manager pm steerco leadership">
              <div class="gtitle">Help</div>
              <div class="navItem" data-page="how-it-works" onclick="openPage('how-it-works')">
                <span style="display:flex;align-items:center;gap:10px"><span class="dot"></span>How it Works</span>
                <small>Guide</small>
              </div>
            </div>

            <div class="footer">
              Replace placeholders like <span class="code">{{IDEA_SUBMISSION_FORM_URL}}</span> with Smartsheet links.
            </div>
          </div>
        </aside>

        <!-- CONTENT -->
        <main>
          <!-- IDEA PORTAL -->
          <section class="page active" id="idea-portal">
            <div class="grid c4">
              <div class="card compact kpi"><div class="label">Open ideas</div><div class="big">84</div><div class="delta ok">▲ 6 this month</div></div>
              <div class="card compact kpi"><div class="label">Needs more info</div><div class="big">12</div><div class="delta warn">requestor action</div></div>
              <div class="card compact kpi"><div class="label">In requirements</div><div class="big">9</div><div class="delta ok">moving</div></div>
              <div class="card compact kpi"><div class="label">Delivered (90 days)</div><div class="big">14</div><div class="delta ok">feedback open</div></div>
            </div>

            <div class="grid c2" style="margin-top:14px">
              <div class="card">
                <h2>Submit &amp; Track</h2>
                <p>Use this Work App to submit ideas, follow updates, and share feedback after delivery.</p>
                <div style="display:flex;gap:10px;flex-wrap:wrap">
                  <button class="btn primary" onclick="fakeLink('{{IDEA_SUBMISSION_FORM_URL}}','Submit an Idea')">Submit an Idea</button>
                  <button class="btn" onclick="openPage('my-ideas')">View My Ideas</button>
                  <button class="btn" onclick="openPage('delivered-feedback')">Give Feedback</button>
                </div>

                <div class="callout" style="margin-top:14px">
                  <div class="ico">🧭</div>
                  <div>
                    <b>What happens next</b>
                    <div style="color:var(--muted);line-height:1.45;margin-top:4px">
                      1) We review and triage new ideas → 2) If needed, we request more info →
                      3) We gather requirements → 4) Approved ideas enter delivery → 5) Delivered ideas open feedback
                    </div>
                  </div>
                </div>

                <hr/>
                <h2>Top Ideas Right Now (example)</h2>
                <table class="table">
                  <thead>
                    <tr><th>ID</th><th>Idea</th><th>Dept</th><th>Region</th><th>Stage</th><th>Roadmap</th></tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td class="mono">IDEA-0241</td><td>Unified US/OUS dashboard filters</td><td>Sales Ops</td><td>Global</td>
                      <td><span class="badge info">Gathering Requirements</span></td><td><span class="badge purple">Next</span></td>
                    </tr>
                    <tr>
                      <td class="mono">IDEA-0237</td><td>Case routing transparency for supervisors</td><td>Customer Service</td><td>US</td>
                      <td><span class="badge info">Under Consideration</span></td><td><span class="badge purple">Now</span></td>
                    </tr>
                    <tr>
                      <td class="mono">IDEA-0229</td><td>Standardize lead disposition values</td><td>Inside Sales</td><td>OUS</td>
                      <td><span class="badge info">Approved</span></td><td><span class="badge purple">Now</span></td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <div class="card">
                <h2>Idea Pipeline by Stage (demo)</h2>
                <div class="miniChart">
                  <div class="barRow"><div class="barLbl">Open</div><div class="bar"><i style="width:78%"></i></div><div class="barVal">28</div></div>
                  <div class="barRow"><div class="barLbl">Under Review</div><div class="bar"><i style="width:64%"></i></div><div class="barVal">18</div></div>
                  <div class="barRow"><div class="barLbl">Needs More Info</div><div class="bar"><i style="width:40%"></i></div><div class="barVal">12</div></div>
                  <div class="barRow"><div class="barLbl">In Research</div><div class="bar"><i style="width:30%"></i></div><div class="barVal">10</div></div>
                  <div class="barRow"><div class="barLbl">Gathering Req.</div><div class="bar"><i style="width:24%"></i></div><div class="barVal">9</div></div>
                  <div class="barRow"><div class="barLbl">Approved</div><div class="bar"><i style="width:18%"></i></div><div class="barVal">6</div></div>
                  <div class="barRow"><div class="barLbl">Delivery</div><div class="bar"><i style="width:16%"></i></div><div class="barVal">5</div></div>
                  <div class="barRow"><div class="barLbl">Done (90d)</div><div class="bar"><i style="width:20%"></i></div><div class="barVal">14</div></div>
                </div>

                <hr/>
                <h2>Recently Delivered (example)</h2>
                <table class="table">
                  <thead><tr><th>ID</th><th>Delivered Item</th><th>Dept</th><th>Region</th><th>Feedback</th></tr></thead>
                  <tbody>
                    <tr>
                      <td class="mono">IDEA-0211</td><td>New “My Leads” dashboard</td><td>Inside Sales</td><td>US</td>
                      <td><span class="badge ok">Open</span></td>
                    </tr>
                    <tr>
                      <td class="mono">IDEA-0204</td><td>Case escalation quick action</td><td>Customer Service</td><td>Global</td>
                      <td><span class="badge ok">Open</span></td>
                    </tr>
                    <tr>
                      <td class="mono">IDEA-0198</td><td>Updated field-level help text</td><td>Compliance</td><td>OUS</td>
                      <td><span class="badge info">Closed</span></td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </section>

          <!-- SUBMIT IDEA -->
          <section class="page" id="submit-idea">
            <div class="card">
              <h2>Submit an Idea (Form)</h2>
              <p>In Smartsheet WorkApps, this page is a button/link to your submission form.</p>
              <div class="callout">
                <div class="ico">🔗</div>
                <div>
                  <b>Form link placeholder</b>
                  <div style="color:var(--muted);line-height:1.45;margin-top:4px">
                    Replace with: <span class="code">{{IDEA_SUBMISSION_FORM_URL}}</span>
                  </div>
