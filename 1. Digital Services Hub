<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>EDSPPM • Digital Services Hub (Interactive)</title>
  <style>
    :root{
      /* Light theme */
      --bg:#f6f8fc;
      --panel:#ffffff;
      --panel2:#f9fbff;
      --text:#0b1220;
      --muted:#55637a;
      --border:rgba(15,23,42,.12);
      --shadow:0 14px 34px rgba(15,23,42,.12);

      /* Brand */
      --brand1:#6d28d9;
      --brand2:#0891b2;

      /* Status */
      --ok:#16a34a;
      --warn:#d97706;
      --bad:#dc2626;

      --r:18px;
      --pad:18px;

      --sans: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
      --mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono","Courier New", monospace;
    }

    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0; font-family:var(--sans); color:var(--text);
      background:
        radial-gradient(900px 480px at 15% 6%, rgba(109,40,217,.12), transparent 60%),
        radial-gradient(800px 420px at 88% 18%, rgba(8,145,178,.10), transparent 55%),
        radial-gradient(700px 420px at 50% 105%, rgba(22,163,74,.08), transparent 60%),
        var(--bg);
    }
    a{color:inherit; text-decoration:none}

    .topbar{
      position:sticky; top:0; z-index:50;
      display:flex; align-items:center; gap:12px;
      padding:14px 16px;
      backdrop-filter: blur(10px);
      background: rgba(255,255,255,.75);
      border-bottom:1px solid var(--border);
    }
    .brand{display:flex; align-items:center; gap:10px; font-weight:900; letter-spacing:.2px;}
    .logo{
      width:34px;height:34px;border-radius:12px;
      background:linear-gradient(135deg,var(--brand1),var(--brand2));
      box-shadow:0 14px 32px rgba(109,40,217,.18);
    }
    .pill{
      display:inline-flex;align-items:center;gap:8px;
      padding:7px 10px;border:1px solid var(--border);
      background:rgba(255,255,255,.9);
      border-radius:999px;color:var(--muted);font-size:12px
    }
    .spacer{flex:1}
    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:8px;
      padding:9px 12px;border-radius:12px;border:1px solid var(--border);
      background:rgba(255,255,255,.95);
      color:var(--text);
      cursor:pointer;
      transition:transform .08s ease, background .15s ease, border-color .15s ease, box-shadow .15s ease;
      box-shadow:0 8px 20px rgba(15,23,42,.06);
    }
    .btn:hover{
      background:#ffffff;
      border-color:rgba(15,23,42,.18);
      box-shadow:0 10px 26px rgba(15,23,42,.10);
    }
    .btn:active{transform:translateY(1px)}
    .btn.primary{
      background:linear-gradient(135deg, rgba(109,40,217,.95), rgba(8,145,178,.92));
      color:#fff;
      border-color:rgba(255,255,255,.35);
      box-shadow:0 14px 28px rgba(109,40,217,.18);
    }

    .wrap{max-width:1280px; margin:0 auto; padding:18px}
    .hero{padding:18px 0 6px 0}
    .hero h1{margin:0 0 8px 0; font-size:30px; letter-spacing:-.02em}
    .hero p{margin:0; color:var(--muted); line-height:1.6}

    .tabs{display:flex; gap:10px; flex-wrap:wrap; margin:12px 0 0 0}
    .tab{
      padding:8px 10px; border-radius:999px;
      border:1px solid var(--border);
      background:rgba(255,255,255,.92);
      color:var(--muted); font-size:13px; cursor:pointer;
      box-shadow:0 8px 18px rgba(15,23,42,.06);
      user-select:none;
    }
    .tab.active{
      background:rgba(109,40,217,.10);
      border-color:rgba(109,40,217,.25);
      color:var(--text)
    }

    .grid{display:grid; gap:14px}
    .grid.c2{grid-template-columns: 1.2fr .8fr}
    .grid.c3{grid-template-columns: 1fr 1fr 1fr}
    .grid.c4{grid-template-columns: 1fr 1fr 1fr 1fr}
    @media (max-width:1100px){ .grid.c2,.grid.c3,.grid.c4{grid-template-columns:1fr} }

    .card{
      border:1px solid var(--border);
      background:var(--panel);
      border-radius: var(--r);
      box-shadow: var(--shadow);
      padding: var(--pad);
    }
    .card.compact{padding:14px; border-radius:16px}
    .card h2{margin:0 0 6px 0; font-size:18px}
    .card p{margin:0 0 10px 0; color:var(--muted); line-height:1.5}

    .kpi .label{color:var(--muted); font-size:12px; letter-spacing:.08em; text-transform:uppercase}
    .kpi .big{font-size:28px; font-weight:900; letter-spacing:-.02em}
    .delta{
      margin-top:6px; display:inline-flex; gap:6px;
      font-size:12px; padding:6px 9px; border-radius:999px;
      border:1px solid var(--border);
      background:rgba(2,6,23,.02);
    }
    .delta.ok{color:#0f5132;border-color:rgba(22,163,74,.22);background:rgba(22,163,74,.08)}
    .delta.warn{color:#7c2d12;border-color:rgba(217,119,6,.22);background:rgba(217,119,6,.08)}
    .delta.bad{color:#7f1d1d;border-color:rgba(220,38,38,.22);background:rgba(220,38,38,.08)}

    .badge{
      display:inline-flex;align-items:center;gap:6px;
      padding:5px 9px;border-radius:999px;font-size:12px;
      border:1px solid var(--border);background:rgba(2,6,23,.02)
    }
    .badge.ok{border-color:rgba(22,163,74,.24);background:rgba(22,163,74,.10);color:#0f5132}
    .badge.warn{border-color:rgba(217,119,6,.24);background:rgba(217,119,6,.10);color:#7c2d12}
    .badge.bad{border-color:rgba(220,38,38,.24);background:rgba(220,38,38,.10);color:#7f1d1d}
    .badge.info{border-color:rgba(8,145,178,.24);background:rgba(8,145,178,.10);color:#0b4b5a}

    .table{
      width:100%; border-collapse:separate; border-spacing:0;
      overflow:hidden; border:1px solid var(--border); border-radius:16px;
      background:#fff;
    }
    .table th,.table td{
      padding:10px 12px;
      border-bottom:1px solid var(--border);
      font-size:13px; vertical-align:top
    }
    .table th{
      color:var(--muted); font-weight:800; text-align:left;
      background:rgba(2,6,23,.02)
    }
    .table tr:last-child td{border-bottom:0}

    .miniChart{
      height:260px; border-radius:16px; border:1px solid var(--border);
      background:rgba(2,6,23,.01);
      padding:14px; display:flex; flex-direction:column; gap:10px;
    }
    .barRow{display:flex; align-items:center; gap:10px}
    .barLbl{width:120px; color:var(--muted); font-size:12px}
    .bar{flex:1; height:10px; border-radius:999px; background:rgba(2,6,23,.08); overflow:hidden}
    .bar > i{display:block; height:100%; width:50%; background:linear-gradient(90deg, rgba(109,40,217,.95), rgba(8,145,178,.92))}
    .barVal{width:46px; text-align:right; font-family:var(--mono); font-size:12px; color:rgba(15,23,42,.88)}

    .cardsGrid{display:grid; gap:14px; grid-template-columns:repeat(2, minmax(0,1fr))}
    @media (max-width:900px){ .cardsGrid{grid-template-columns:1fr} }

    .callout{
      display:flex; gap:12px; padding:12px 14px; border-radius:16px;
      border:1px dashed rgba(15,23,42,.18);
      background:rgba(255,255,255,.85);
    }
    .ico{
      width:30px; height:30px; border-radius:12px;
      display:grid; place-items:center;
      border:1px solid var(--border);
      background:rgba(2,6,23,.02)
    }
    .code{
      font-family:var(--mono); font-size:12px;
      padding:2px 6px; border:1px solid var(--border);
      border-radius:10px; background:rgba(2,6,23,.02)
    }

    .page{display:none}
    .page.active{display:block}
    .footer{color:var(--muted); font-size:12px; margin-top:12px}
    hr{border:0;border-top:1px solid var(--border);margin:14px 0}
  </style>
</head>
<body>
  <div class="topbar">
    <div class="brand"><div class="logo"></div>Digital Services Hub</div>
    <div class="pill">Enterprise Digital Services Portfolio &amp; Program Management (EDSPPM)</div>
    <div class="spacer"></div>
    <button class="btn" id="modeBtn" title="Toggle demo vs embed placeholder">Demo Mode</button>
    <a class="btn primary" href="#" onclick="switchPage('hub');return false;">Hub</a>
  </div>

  <div class="wrap">
    <div class="hero">
      <h1>One enterprise ecosystem (US + OUS)</h1>
      <p>One front door to submit work, view priorities, track delivery, operate, and report across our Digital Services systems.</p>
      <div class="tabs">
        <div class="tab active" data-tab="hub" onclick="switchPage('hub')">Hub Dashboard</div>
        <div class="tab" data-tab="pp" onclick="switchPage('pp')">1) Product &amp; Portfolio</div>
        <div class="tab" data-tab="dd" onclick="switchPage('dd')">2) DevOps &amp; Delivery</div>
        <div class="tab" data-tab="rv" onclick="switchPage('rv')">3) Run &amp; Vendor Ops</div>
        <div class="tab" data-tab="gr" onclick="switchPage('gr')">4) Governance &amp; Reporting</div>
      </div>
    </div>

    <!-- HUB -->
    <section class="page active" id="page-hub">
      <div class="grid c4">
        <div class="card compact kpi"><div class="label">Open items enterprise-wide</div><div class="big">128</div><div class="delta ok">▲ 6 vs last week</div></div>
        <div class="card compact kpi"><div class="label">At risk (SLA / dates)</div><div class="big">14</div><div class="delta warn">⏱️ review today</div></div>
        <div class="card compact kpi"><div class="label">Releases next 30 days</div><div class="big">9</div><div class="delta ok">▲ 2 added</div></div>
        <div class="card compact kpi"><div class="label">Delivery success rate</div><div class="big">95%</div><div class="delta ok">▲ 1% QoQ</div></div>
      </div>

      <div class="grid c2" style="margin-top:14px">
        <div class="card">
          <h2>WorkApps</h2>
          <p>These are themed WorkApps — Roles control which pages each persona sees.</p>
          <div class="cardsGrid">
            <a class="card" href="#" onclick="switchPage('pp');return false;">
              <h2>Product &amp; Portfolio Management</h2>
              <p>Idea portal, roadmaps, backlog, portfolio allocation.</p>
              <div style="display:flex;gap:10px;flex-wrap:wrap">
                <span class="badge info">Intake + Roadmaps</span><span class="badge">Portfolio views</span>
              </div>
            </a>
            <a class="card" href="#" onclick="switchPage('dd');return false;">
              <h2>DevOps &amp; Delivery</h2>
              <p>Sprints, QA/UAT, release readiness.</p>
              <div style="display:flex;gap:10px;flex-wrap:wrap">
                <span class="badge info">Sprint execution</span><span class="badge">Testing</span>
              </div>
            </a>
            <a class="card" href="#" onclick="switchPage('rv');return false;">
              <h2>Run &amp; Vendor Ops</h2>
              <p>SRs, incidents, vendors/licenses, app validation.</p>
              <div style="display:flex;gap:10px;flex-wrap:wrap">
                <span class="badge warn">Run support</span><span class="badge">Renewals</span>
              </div>
            </a>
            <a class="card" href="#" onclick="switchPage('gr');return false;">
              <h2>Governance &amp; Reporting</h2>
              <p>Approvals, reporting pack, decision log.</p>
              <div style="display:flex;gap:10px;flex-wrap:wrap">
                <span class="badge info">Approvals</span><span class="badge">Exec dashboards</span>
              </div>
            </a>
          </div>

          <div class="callout" style="margin-top:14px">
            <div class="ico">🌍</div>
            <div>
              <b>How to make this “the enterprise home”</b>
              <div style="color:var(--muted);line-height:1.45">
                Share the Hub dashboard to all users (US + OUS), ask users to star it, and link it from Teams/SharePoint.
                For embeds later, replace URL placeholders like <span class="code">{{HUB_DASHBOARD_PUBLISH_URL}}</span>.
              </div>
            </div>
          </div>
        </div>

        <div class="card">
          <h2>This week’s highlights</h2>
          <p>High-signal updates only.</p>
          <table class="table">
            <thead><tr><th>What’s moving</th><th>Owner</th><th>Next step</th><th>Due</th></tr></thead>
            <tbody>
              <tr><td>Roadmap refresh published (US + OUS)</td><td>Product Ops</td><td>Share highlights</td><td>Feb 6</td></tr>
              <tr><td>Release R-26.02 readiness review</td><td>Release Mgr</td><td>Confirm go/no-go checklist</td><td>Feb 9</td></tr>
              <tr><td>INC-1042: Omni routing backlog</td><td>Run Ops</td><td>Implement fix + postmortem</td><td>Feb 5</td></tr>
              <tr><td>Smartsheet license true-up</td><td>Vendor Ops</td><td>Finalize seat counts</td><td>Feb 20</td></tr>
            </tbody>
          </table>

          <div class="miniChart" style="margin-top:14px">
            <div style="display:flex;justify-content:space-between;align-items:baseline">
              <div>
                <div style="font-weight:900">Demand vs Completion</div>
                <div style="color:var(--muted);font-size:12px">Demo throughput trend</div>
              </div>
              <span class="badge info">Last 6 weeks</span>
            </div>
            <div class="barRow"><div class="barLbl">Intake</div><div class="bar"><i style="width:86%"></i></div><div class="barVal">73</div></div>
            <div class="barRow"><div class="barLbl">Completed</div><div class="bar"><i style="width:70%"></i></div><div class="barVal">59</div></div>
            <div class="barRow"><div class="barLbl">At Risk</div><div class="bar"><i style="width:28%"></i></div><div class="barVal">14</div></div>
          </div>
        </div>
      </div>

      <div class="card" style="margin-top:14px" data-embed>
        <h2>Embed placeholder</h2>
        <p>Replace <span class="code">{{HUB_DASHBOARD_PUBLISH_URL}}</span> with your published Smartsheet Hub dashboard URL.</p>
        <div class="callout"><div class="ico">🔗</div><div><b>Embed URL</b><div style="color:var(--muted)">{{HUB_DASHBOARD_PUBLISH_URL}}</div></div></div>
      </div>
    </section>

    <!-- WorkApp 1: Product & Portfolio -->
    <section class="page" id="page-pp">
      <div class="grid c4">
        <div class="card compact kpi"><div class="label">Ideas under evaluation</div><div class="big">38</div><div class="delta ok">▲ 4 this week</div></div>
        <div class="card compact kpi"><div class="label">In roadmap (Now/Next)</div><div class="big">22</div><div class="delta ok">▲ 2 added</div></div>
        <div class="card compact kpi"><div class="label">Epics active</div><div class="big">11</div><div class="delta warn">⏱️ 3 at risk</div></div>
        <div class="card compact kpi"><div class="label">Strategic candidates</div><div class="big">6</div><div class="delta warn">SteerCo review</div></div>
      </div>

      <div class="grid c2" style="margin-top:14px">
        <div class="card">
          <h2>Idea Portal (example)</h2>
          <p>Submit an idea, track your submissions, and review feedback.</p>
          <div style="display:flex; gap:10px; flex-wrap:wrap">
            <a class="btn primary" href="#" onclick="alert('Replace with {{IDEA_FORM_URL}}');return false;">Submit Idea</a>
            <a class="btn" href="#" onclick="alert('Replace with Idea Portal dashboard publish link');return false;">Open Idea Dashboard</a>
          </div>
          <hr />
          <table class="table">
            <thead><tr><th>ID</th><th>Idea</th><th>Status</th><th>Last update</th></tr></thead>
            <tbody>
              <tr><td>IDEA-0218</td><td>Improve global case routing transparency</td><td><span class="badge info">Under Review</span></td><td>Yesterday</td></tr>
              <tr><td>IDEA-0215</td><td>OUS-specific SLA dashboard views</td><td><span class="badge warn">Needs Info</span></td><td>2 days ago</td></tr>
              <tr><td>IDEA-0206</td><td>Standardize lead disposition picklists</td><td><span class="badge ok">Planned</span></td><td>Last week</td></tr>
            </tbody>
          </table>
        </div>

        <div class="card">
          <h2>Portfolio Allocation (demo)</h2>
          <p>Run / Grow / Transform / Explore mix.</p>
          <div class="miniChart">
            <div class="barRow"><div class="barLbl">Run</div><div class="bar"><i style="width:72%"></i></div><div class="barVal">40%</div></div>
            <div class="barRow"><div class="barLbl">Grow</div><div class="bar"><i style="width:44%"></i></div><div class="barVal">25%</div></div>
            <div class="barRow"><div class="barLbl">Transform</div><div class="bar"><i style="width:40%"></i></div><div class="barVal">22%</div></div>
            <div class="barRow"><div class="barLbl">Explore</div><div class="bar"><i style="width:24%"></i></div><div class="barVal">13%</div></div>
          </div>
        </div>
      </div>

      <div class="grid c2" style="margin-top:14px">
        <div class="card">
          <h2>Roadmaps (Now / Next / Later)</h2>
          <table class="table">
            <thead><tr><th>Horizon</th><th>Epic/Theme</th><th>Outcome</th><th>Target</th></tr></thead>
            <tbody>
              <tr><td>Now</td><td>Case SLA Automation (Global)</td><td>Reduce SLA breaches; improve triage speed</td><td>Mar</td></tr>
              <tr><td>Now</td><td>Lead Follow-up Automation</td><td>Increase contact rate and rep capacity</td><td>Mar</td></tr>
              <tr><td>Next</td><td>Self-service Portal Iterations</td><td>Deflect inbound requests; improve UX</td><td>Apr</td></tr>
              <tr><td>Later</td><td>Data quality program</td><td>Improve reporting accuracy enterprise-wide</td><td>Q2</td></tr>
            </tbody>
          </table>
        </div>

        <div class="card">
          <h2>Backlog snapshot</h2>
          <table class="table">
            <thead><tr><th>Epic</th><th>Feature</th><th>Status</th><th>Owner</th></tr></thead>
            <tbody>
              <tr><td>E-104 Case & Support Mgmt</td><td>SLA breach alerts</td><td><span class="badge warn">In progress</span></td><td>PM</td></tr>
              <tr><td>E-090 Lead Management</td><td>Automated follow-up sequences</td><td><span class="badge ok">Ready</span></td><td>PM</td></tr>
              <tr><td>E-077 Reporting & Analytics</td><td>Executive global dashboard</td><td><span class="badge info">In research</span></td><td>PM</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="card" style="margin-top:14px">
        <h2>Role-based access (recommended)</h2>
        <table class="table">
          <thead><tr><th>Page</th><th>Visible to Roles</th><th>Typical Access</th></tr></thead>
          <tbody>
            <tr><td>Overview</td><td>Functional Leader, Leadership, Product Manager</td><td>View</td></tr>
            <tr><td>Idea Portal</td><td>Submitter, Functional Leader</td><td>View (forms)</td></tr>
            <tr><td>Roadmaps</td><td>Submitter, Functional Leader, Leadership, SteerCo, Product Manager</td><td>View</td></tr>
            <tr><td>Backlog</td><td>Product Manager, Developer, QA</td><td>PM edit / others view</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- WorkApp 2: DevOps & Delivery -->
    <section class="page" id="page-dd">
      <div class="grid c4">
        <div class="card compact kpi"><div class="label">Active sprints</div><div class="big">2</div><div class="delta ok">Sprint 4 • Sprint 5</div></div>
        <div class="card compact kpi"><div class="label">Sprint completion</div><div class="big">67%</div><div class="delta ok">▲ 5% vs last</div></div>
        <div class="card compact kpi"><div class="label">Defects open</div><div class="big">9</div><div class="delta warn">2 high</div></div>
        <div class="card compact kpi"><div class="label">UAT pending areas</div><div class="big">3</div><div class="delta warn">Needs sign-off</div></div>
      </div>

      <div class="grid c2" style="margin-top:14px">
        <div class="card">
          <h2>Sprint board (example)</h2>
          <table class="table">
            <thead><tr><th>Story</th><th>Summary</th><th>Assignee</th><th>Status</th></tr></thead>
            <tbody>
              <tr><td>US-882</td><td>Off-schedule hold queue routing</td><td>Dev A</td><td><span class="badge warn">In progress</span></td></tr>
              <tr><td>US-891</td><td>Case SLA alert rules (global)</td><td>Dev B</td><td><span class="badge info">Ready</span></td></tr>
              <tr><td>US-903</td><td>Dashboard filters for US/OUS</td><td>Dev C</td><td><span class="badge bad">Blocked</span></td></tr>
            </tbody>
          </table>
        </div>
        <div class="card">
          <h2>Release readiness (demo)</h2>
          <div class="miniChart">
            <div class="barRow"><div class="barLbl">Build</div><div class="bar"><i style="width:88%"></i></div><div class="barVal">88</div></div>
            <div class="barRow"><div class="barLbl">QA</div><div class="bar"><i style="width:74%"></i></div><div class="barVal">74</div></div>
            <div class="barRow"><div class="barLbl">UAT</div><div class="bar"><i style="width:61%"></i></div><div class="barVal">61</div></div>
            <div class="barRow"><div class="barLbl">CAB</div><div class="bar"><i style="width:58%"></i></div><div class="barVal">58</div></div>
          </div>
        </div>
      </div>

      <div class="grid c2" style="margin-top:14px">
        <div class="card">
          <h2>QA / Testing</h2>
          <table class="table">
            <thead><tr><th>Bug</th><th>Severity</th><th>Area</th><th>Status</th><th>Age</th></tr></thead>
            <tbody>
              <tr><td>BUG-412</td><td><span class="badge bad">High</span></td><td>Lead conversion</td><td><span class="badge warn">In progress</span></td><td>1d</td></tr>
              <tr><td>BUG-417</td><td><span class="badge warn">Med</span></td><td>Reports</td><td><span class="badge info">Assigned</span></td><td>2d</td></tr>
              <tr><td>BUG-419</td><td><span class="badge warn">Med</span></td><td>UI/UX</td><td><span class="badge info">Needs repro</span></td><td>3d</td></tr>
            </tbody>
          </table>
        </div>
        <div class="card">
          <h2>UAT Sign-off (US + OUS)</h2>
          <table class="table">
            <thead><tr><th>Area</th><th>Owner</th><th>Status</th><th>Notes</th></tr></thead>
            <tbody>
