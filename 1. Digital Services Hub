  <script>
    let embedMode = false;

    function switchPage(key){
      document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
      document.querySelectorAll(".tab").forEach(t=>t.classList.remove("active"));

      const page = document.getElementById("page-" + key);
      if(page) page.classList.add("active");

      const tab = document.querySelector('.tab[data-tab="'+key+'"]');
      if(tab) tab.classList.add("active");

      window.scrollTo({top:0, behavior:"smooth"});
    }

    function setEmbedVisibility(){
      // In a real embed mode you would show iframes. Here we only show/hide embed placeholders.
      document.querySelectorAll("[data-embed]").forEach(el=>{
        el.style.display = embedMode ? "block" : "none";
      });
      document.getElementById("modeBtn").textContent = embedMode ? "Embed Mode" : "Demo Mode";
    }

    document.getElementById("modeBtn").addEventListener("click", ()=>{
      embedMode = !embedMode;
      setEmbedVisibility();
    });

    setEmbedVisibility();
  </script>
