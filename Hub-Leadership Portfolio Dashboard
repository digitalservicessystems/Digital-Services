<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leadership Portfolio Dashboard</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f3f4f6;
        }
        .dashboard-section {
            display: none;
        }
        .dashboard-section.active {
            display: block;
        }
        /* Card Styling */
        .card {
            background-color: #ffffff;
            border-radius: 0.75rem;
            padding: 1.5rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        }
        /* KPI Styling */
        .kpi-value {
            font-size: 2.5rem;
            font-weight: 700;
        }
        .kpi-label {
            font-size: 0.9rem;
            color: #4b5563;
        }
        /* Table styling */
        .dashboard-table th, .dashboard-table td {
            padding: 0.75rem;
            text-align: left;
            border-bottom: 1px solid #e2e8f0;
        }
        .dashboard-table th {
            background-color: #f8fafc;
            font-weight: 600;
            color: #334155;
        }
        .dashboard-table tbody tr:hover {
            background-color: #f0f4f8;
        }
        .chart-placeholder {
            background-color: #eef2ff;
            border-radius: 0.5rem;
            height: 250px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #6366f1;
            font-weight: 500;
            border: 1px dashed #a5b4fc;
        }
    </style>
</head>
<body class="p-6">
    <div class="max-w-7xl mx-auto bg-white rounded-lg shadow-xl overflow-hidden">
        <!-- Dashboard Header (Executive Theme) -->
        <header class="bg-gray-700 text-white p-6 rounded-t-lg">
            <div class="flex items-center gap-4">
                <i class="fas fa-sitemap text-4xl text-yellow-400"></i>
                <div>
                    <h1 class="text-3xl font-bold mb-1">Executive Leadership Portfolio Dashboard</h1>
                    <p class="text-lg opacity-90">Strategic progress, health, and risk overview.</p>
                </div>
            </div>
        </header>

        <!-- Navigation Tabs -->
        <nav class="bg-gray-100 p-4 border-b border-gray-200 flex flex-wrap justify-center sm:justify-start gap-2">
            <button class="nav-button active bg-gray-600 text-white px-4 py-2 rounded-md shadow-sm hover:bg-gray-700 transition-colors" data-section="overview-metrics">Overview & Health</button>
            <button class="nav-button bg-gray-200 text-gray-800 px-4 py-2 rounded-md shadow-sm hover:bg-gray-300 transition-colors" data-section="velocity-risk">Delivery & Risk</button>
        </nav>

        <!-- Dashboard Content Sections -->
        <div class="p-6">
            
            <!-- Section 1: Overview & Health (Portfolio Overview, Release Calendar) -->
            <section id="overview-metrics" class="dashboard-section active">
                
                <!-- Key Health Metrics -->
                <h2 class="text-2xl font-semibold text-gray-800 mb-4">Strategic Health Summary</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
                    <!-- Metric 1: Total Value Score -->
                    <div class="card bg-purple-50 p-4 border-l-4 border-purple-600">
                        <p class="kpi-value text-purple-800">8.5 / 10</p>
                        <p class="kpi-label">Overall Portfolio Health Score</p>
                    </div>
                    <!-- Metric 2: Progress Against Target -->
                    <div class="card bg-blue-50 p-4 border-l-4 border-blue-600">
                        <p class="kpi-value text-blue-800">75%</p>
                        <p class="kpi-label">Q4 Strategic Progress Complete</p>
                    </div>
                    <!-- Metric 3: Critical Risks -->
                    <div class="card bg-red-50 p-4 border-l-4 border-red-600">
                        <p class="kpi-value text-red-800">2</p>
                        <p class="kpi-label">Critical Open Risks (High Impact)</p>
                    </div>
                    <!-- Metric 4: Next Deployment -->
                    <div class="card bg-green-50 p-4 border-l-4 border-green-600">
                        <p class="kpi-value text-green-800">2025-12-05</p>
                        <p class="kpi-label">Next Planned Deployment Date</p>
                    </div>
                </div>

                <!-- Report: Portfolio Overview -->
                <div class="card overflow-x-auto mb-8">
                    <h3 class="text-xl font-semibold text-gray-700 mb-3">Strategic Portfolio Overview</h3>
                    <p class="text-gray-500 mb-4">Summarizes epics and initiatives, showing health and progress roll-ups.</p>
                    <table class="min-w-full dashboard-table">
                        <thead>
                            <tr>
                                <th class="w-2/12">Portfolio Item</th>
                                <th class="w-1/12">Product</th>
                                <th class="w-1/12">Region</th>
                                <th class="w-1/12">MoSCoW</th>
                                <th class="w-1/12">Status</th>
                                <th class="w-1/12">Health</th>
                                <th class="w-1/12">Target Qtr</th>
                                <th class="w-1/12">Progress %</th>
                                <th class="w-1/12">Value Score</th>
                                <th class="w-1/12">PBI Link</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>CRM Consolidation Initiative</td>
                                <td>Sales</td>
                                <td>Global</td>
                                <td>Must Have</td>
                                <td class="text-blue-600 font-medium">In Dev</td>
                                <td class="text-yellow-600 font-medium">Warning</td>
                                <td>Q4 2025</td>
                                <td>55%</td>
                                <td>9.1</td>
                                <td><i class="fas fa-link text-gray-500"></i></td>
                            </tr>
                            <tr>
                                <td>New Customer Portal MVP</td>
                                <td>Service</td>
                                <td>US/CA</td>
                                <td>Should Have</td>
                                <td class="text-green-600 font-medium">Deployed</td>
                                <td class="text-green-600 font-medium">On Track</td>
                                <td>Q3 2025</td>
                                <td>100%</td>
                                <td>8.5</td>
                                <td><i class="fas fa-link text-gray-500"></i></td>
                            </tr>
                            <tr>
                                <td>Data Governance Enhancement</td>
                                <td>Platform</td>
                                <td>EU</td>
                                <td>Must Have</td>
                                <td class="text-yellow-600 font-medium">In Scoping</td>
                                <td class="text-red-600 font-medium">At Risk</td>
                                <td>Q1 2026</td>
                                <td>10%</td>
                                <td>9.5</td>
                                <td><i class="fas fa-link text-gray-500"></i></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Report: Release Calendar -->
                <div class="card overflow-x-auto">
                    <h3 class="text-xl font-semibold text-gray-700 mb-3">Release Calendar (Next 6 Months)</h3>
                    <p class="text-gray-500 mb-4">Provides a high-level view of upcoming deployments.</p>
                    <table class="min-w-full dashboard-table">
                        <thead>
                            <tr>
                                <th class="w-3/12">Release</th>
                                <th class="w-2/12">Target Date</th>
                                <th class="w-2/12">Status</th>
                                <th class="w-3/12">Theme</th>
                                <th class="w-2/12">Notes</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Platform Patch R4.1</td>
                                <td>2025-12-05</td>
                                <td class="text-green-600 font-medium">Confirmed</td>
                                <td>Maintenance/Security</td>
                                <td>Critical bug fixes only.</td>
                            </tr>
                            <tr>
                                <td>Major Feature Release 5.0</td>
                                <td>2026-01-20</td>
                                <td class="text-blue-600 font-medium">Scheduled</td>
                                <td>Growth (Consolidation)</td>
                                <td>Includes CRM Consolidation features.</td>
                            </tr>
                            <tr>
                                <td>Data Prep Phase 2</td>
                                <td>2026-03-15</td>
                                <td class="text-yellow-600 font-medium">Tentative</td>
                                <td>Compliance</td>
                                <td>Requires external vendor sign-off.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Section 2: Delivery & Risk (Velocity, Burndown, Open Risks) -->
            <section id="velocity-risk" class="dashboard-section">
                <h2 class="text-2xl font-semibold text-gray-800 mb-4">Delivery Predictability & Risk Management</h2>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
                    <!-- Report: Velocity and Burndown -->
                    <div class="card lg:col-span-2">
                        <h3 class="text-xl font-semibold text-gray-700 mb-3">Velocity and Burndown</h3>
                        <p class="text-gray-500 mb-4">Tracks team velocity and current sprint status to assess predictability.</p>
                        <div class="grid grid-cols-2 gap-4 mb-4">
                            <div class="bg-indigo-50 p-3 rounded-lg">
                                <p class="text-sm text-gray-600">Avg. Velocity (Last 4 Sprints)</p>
                                <p class="text-2xl font-bold text-indigo-800">28 pts</p>
                            </div>
                            <div class="bg-red-50 p-3 rounded-lg">
                                <p class="text-sm text-gray-600">Current Sprint Status</p>
                                <p class="text-2xl font-bold text-red-800">At Risk (-5 pts)</p>
                            </div>
                        </div>
                        <div class="chart-placeholder h-64">
                            Line Chart: Current Sprint Burndown (Ideal vs. Actual Remaining Story Points)
                        </div>
                    </div>
                    
                    <!-- Analytics: Flow Efficiency -->
                    <div class="card">
                        <h3 class="text-xl font-semibold text-gray-700 mb-3">Flow Efficiency Analytics</h3>
                        <div class="chart-placeholder h-64">
                            Bar Chart: Average Time in Stage (Triage, Scoping, Dev, QA)
                        </div>
                        <p class="text-sm text-gray-500 mt-2">Identifies workflow bottlenecks affecting Lead Time.</p>
                    </div>
                </div>

                <!-- Report: Open Risks and Issues -->
                <div class="card overflow-x-auto">
                    <h3 class="text-xl font-semibold text-gray-700 mb-3">Critical Open Risks and Issues</h3>
                    <p class="text-gray-500 mb-4">Highlights risks affecting high-priority portfolio items.</p>
                    <table class="min-w-full dashboard-table">
                        <thead>
                            <tr>
                                <th class="w-1/12">ID</th>
                                <th class="w-1/12">Type</th>
                                <th class="w-4/12">Description</th>
                                <th class="w-1/12">Severity</th>
                                <th class="w-1/12">Status</th>
                                <th class="w-1/12">Product</th>
                                <th class="w-1/12">Owner</th>
                                <th class="w-2/12">Mitigation Plan</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>R-005</td>
                                <td>Risk</td>
                                <td>Data Governance project scope creep due to regulatory changes.</td>
                                <td class="text-red-600 font-medium">High</td>
                                <td class="text-yellow-600 font-medium">Active</td>
                                <td>Platform</td>
                                <td>Exec Sponsor</td>
                                <td>Formal scope lock & change request requirement.</td>
                            </tr>
                            <tr>
                                <td>I-012</td>
                                <td>Issue</td>
                                <td>Key developer resource leaving in January, impacting Release 5.0 timeline.</td>
                                <td class="text-red-600 font-medium">High</td>
                                <td class="text-orange-600 font-medium">Monitoring</td>
                                <td>Sales</td>
                                <td>HR Lead</td>
                                <td>Accelerate knowledge transfer and hire backfill.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const navButtons = document.querySelectorAll('.nav-button');
            const sections = document.querySelectorAll('.dashboard-section');

            // Tab switching logic
            navButtons.forEach(button => {
                button.addEventListener('click', () => {
                    navButtons.forEach(btn => {
                        btn.classList.remove('active', 'bg-gray-600', 'text-white');
                        btn.classList.add('bg-gray-200', 'text-gray-800');
                    });
                    sections.forEach(sec => sec.classList.remove('active'));

                    button.classList.add('active', 'bg-gray-600', 'text-white');
                    button.classList.remove('bg-gray-200', 'text-gray-800');

                    const targetSectionId = button.dataset.section;
                    document.getElementById(targetSectionId).classList.add('active');
                });
            });
        });
    </script>
</body>
</html>
